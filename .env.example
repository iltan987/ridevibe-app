# Copy to .env.local. Local values come from `pnpm db:status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google OAuth clients, read by the Supabase CLI from `.env` (project root,
# git-ignored) via env() in supabase/config.toml. Don't use SUPABASE_* names.
# GOOGLE_LOCAL_CLIENT_ID=
# GOOGLE_LOCAL_CLIENT_SECRET=
# GOOGLE_PROD_CLIENT_ID=
# GOOGLE_PROD_CLIENT_SECRET=
