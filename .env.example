# Copy to .env.local. Local values come from `pnpm db:status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Used by the local Supabase stack (supabase/config.toml) for Google sign-in.
# Put these in `.env` (project root, git-ignored) - the Supabase CLI reads that file.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
