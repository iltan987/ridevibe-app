{
  "autoMemoryDirectory": "~/projects/ridingclub/.claude/memory",
  "idleCompaction": false,
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash",
      "Read",
      "Write",
      "Skill",
      "mcp__plugin_context7_context7__query-docs",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_vercel_vercel__get_bulk_availability",
      "mcp__plugin_vercel_vercel__get_bulk_price",
      "mcp__plugin_vercel_vercel__get_runtime_logs"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/db/guard-hook.mts\"" }]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@anthropic-plugin-directory": true,
    "claude-md-management@anthropic-plugin-directory": true,
    "context7@anthropic-plugin-directory": true,
    "frontend-design@anthropic-plugin-directory": true,
    "typescript-lsp@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "vercel@claude-plugins-official": true
  }
}
