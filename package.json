{
  "name": "ridingclub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prepare": "husky",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:migration": "supabase db schema declarative sync --no-apply -f",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts",
    "db:backup": "node scripts/db/production.mts backup",
    "db:push": "node scripts/db/production.mts push"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "libphonenumber-js": "^1.13.17",
    "lucide-react": "^1.80.0",
    "next": "16.4.6",
    "next-intl": "^4.16.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-phone-number-input": "^3.4.18",
    "shadcn": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@tailwindcss/turbopack": "^4.3.5",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vercel/config": "^0.15.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^3.4.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.74.0"
  },
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "26.x"
  }
}
